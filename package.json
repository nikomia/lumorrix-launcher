{
  "name": "lumorrix-launcher",
  "productName": "Lumorrix",
  "version": "0.1.0",
  "description": "Лаунчер сервера Lumorrix",
  "author": "Lumorrix",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-preact": "1.70.0",
    "preact": "11.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "smol-toml": "1.9.1",
    "yauzl": "3.4.0"
  },
  "build": {
    "appId": "ru.lumorrix.launcher",
    "productName": "Lumorrix",
    "copyright": "Lumorrix",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Lumorrix",
      "artifactName": "Lumorrix-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumorrix",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://lumorrix.ru/launcher/"
      }
    ]
  }
}
